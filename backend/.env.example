# ============================================================
# SDMS Backend - Environment Configuration
# Salin file ini menjadi .env dan sesuaikan nilainya
# ============================================================

# App
NODE_ENV=development
PORT=3000
APP_NAME=SDMS
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173

# JWT
JWT_SECRET=ganti_dengan_secret_key_yang_panjang_dan_aman
JWT_EXPIRES_IN=8h
JWT_REFRESH_SECRET=ganti_dengan_refresh_secret_yang_berbeda
JWT_REFRESH_EXPIRES_IN=7d

# ============================================================
# DATABASE MASTER (PostgreSQL) - Single Source of Truth
# ============================================================
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=sdms_master
PG_USER=sdms_user
PG_PASSWORD=password_postgresql

# ============================================================
# DATABASE LMS (PostgreSQL)
# ============================================================
LMS_PG_HOST=localhost
LMS_PG_PORT=5432
LMS_PG_DATABASE=lms_db
LMS_PG_USER=lms_user
LMS_PG_PASSWORD=password_lms

# ============================================================
# DATABASE JURNAL GURU (MongoDB)
# ============================================================
MONGO_URI=mongodb://localhost:27017/jurnal_db
MONGO_USER=mongo_user
MONGO_PASSWORD=password_mongo

# ============================================================
# DATABASE PIKET, SHOLAT, KEGIATAN, KELULUSAN, WEBSITE (MariaDB)
# ============================================================
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=sdms_mysql
MYSQL_PASSWORD=password_mariadb

PIKET_DB=piket_db
SHOLAT_DB=sholat_db
KEGIATAN_DB=kegiatan_db
KELULUSAN_DB=kelulusan_db
WEBSITE_DB=website_db

# ============================================================
# REDIS (Cache & Queue)
# ============================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ============================================================
# RATE LIMIT
# ============================================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ============================================================
# CORS
# ============================================================
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3001

# ============================================================
# LOGGING
# ============================================================
LOG_LEVEL=info
LOG_DIR=logs

# ============================================================
# URL APLIKASI EKSTERNAL (untuk SSO redirect)
# ============================================================
LMS_URL=http://localhost:4000
JURNAL_URL=http://localhost:4001
PIKET_URL=http://localhost:4002
SHOLAT_URL=http://localhost:4003
KEGIATAN_URL=http://localhost:4004
KELULUSAN_URL=http://localhost:4005
WEBSITE_URL=http://localhost:4006
